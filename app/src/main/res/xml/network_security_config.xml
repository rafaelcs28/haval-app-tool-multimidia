<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext only for the dashcam on its own Wi-Fi (DashcamVideoDataSource streams the clips with
  HttpURLConnection, which enforces this policy). Everything else keeps the platform default.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.1</domain>
    </domain-config>
</network-security-config>
